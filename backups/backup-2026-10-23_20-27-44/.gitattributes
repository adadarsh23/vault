# ==============================================================================
# Vault Project - Git Attributes Configuration
# ==============================================================================
# Enterprise-grade Git attributes for Vault:
# - Cross-platform line ending normalization (LF standard across macOS/Linux/Windows)
# - Specialized Git diff drivers for syntax-aware diffs (TypeScript, HTML, CSS, Markdown, etc.)
# - Safe merge handling for package lockfiles
# - Binary file definitions preventing corruption or unintended whitespace conversions
# - GitHub Linguist categorization (language statistics, documentation, generated files)
# - Git Archive release optimization (export-ignore for CI, tests, and ephemeral files)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GLOBAL DEFAULTS & LINE ENDING NORMALIZATION
# ------------------------------------------------------------------------------
# Auto-detect all files as text and normalize line endings to LF on commit.
* text=auto eol=lf

# Explicit binary fallback (disable line ending changes or text diff heuristics)
*.bin                       binary

# ------------------------------------------------------------------------------
# 2. SOURCE CODE & LANGUAGE DIFF DRIVERS
# ------------------------------------------------------------------------------
# TypeScript & JavaScript (Vault UI, Server, Workers & Utilities)
*.ts                        text eol=lf diff=typescript
*.tsx                       text eol=lf diff=typescript
*.mts                       text eol=lf diff=typescript
*.cts                       text eol=lf diff=typescript
*.d.ts                      text eol=lf diff=typescript
*.js                        text eol=lf diff=javascript
*.jsx                       text eol=lf diff=javascript
*.mjs                       text eol=lf diff=javascript
*.cjs                       text eol=lf diff=javascript
*.es                        text eol=lf diff=javascript
*.es6                       text eol=lf diff=javascript

# Web Styles & CSS Preprocessors
*.css                       text eol=lf diff=css
*.scss                      text eol=lf diff=css
*.sass                      text eol=lf diff=css
*.less                      text eol=lf diff=css
*.postcss                   text eol=lf diff=css
*.pcss                      text eol=lf diff=css
*.styl                      text eol=lf diff=css

