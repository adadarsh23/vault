# ------------------------------------------------------------------------------
# 4. MAINTENANCE, AUTOMATION & PLATFORM SCRIPTS
# ------------------------------------------------------------------------------
# POSIX Shell Scripts (MUST strictly have LF line endings to avoid \r errors)
*.sh                        text eol=lf diff=bash
*.bash                      text eol=lf diff=bash
*.zsh                       text eol=lf diff=bash
*.fish                      text eol=lf diff=bash
*.ksh                       text eol=lf diff=bash

# Windows Batch & Command Prompt (MUST strictly have CRLF line endings)
*.bat                       text eol=crlf
*.cmd                       text eol=crlf
*.reg                       text eol=crlf

# PowerShell Scripts (LF safe across Windows PowerShell 5.1 and PS Core / Linux)
*.ps1                       text eol=lf
*.psm1                      text eol=lf
*.psd1                      text eol=lf

# Repository-specific Maintenance Scripts
push.sh                     text eol=lf diff=bash
push.ps1                    text eol=lf
verify_jwt_fix.sh           text eol=lf diff=bash
