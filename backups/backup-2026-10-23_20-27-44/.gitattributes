Cargo.lock                  text -diff merge=binary linguist-generated=true
composer.lock               text -diff merge=binary linguist-generated=true
Gemfile.lock                text -diff merge=binary linguist-generated=true
poetry.lock                 text -diff merge=binary linguist-generated=true
Pipfile.lock                text -diff merge=binary linguist-generated=true

