{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Base Language & Environment */
    "target": "ES2022",
    "lib": ["ES2022"],
    "useDefineForClassFields": true,
    "moduleDetection": "force",

    /* Module System & Resolution */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,

    /* Interop & Type Definitions */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node", "express", "multer"],

    /* Strict Type-Checking */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    /* Optional Advanced Strictness */
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["server.ts", "server/**/*.ts", "server/**/*.d.ts", "server/**/*.js"],
  "exclude": ["node_modules", "dist", "build", "coverage", "src", "public"]
}
