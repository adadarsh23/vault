# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION FOR RENDER
# Copy and paste these into Render Dashboard -> Environment -> "Add from .env"
# ============================================================================

# Runtime Environment
NODE_ENV=production
PORT=10000

# Client & Public URLs (Replace with your actual Render service URL)
CLIENT_URL=https://my-vault-cic6.onrender.com
PUBLIC_URL=https://my-vault-cic6.onrender.com
VITE_APP_PUBLIC_URL=https://my-vault-cic6.onrender.com/
VITE_API_BASE_URL=https://my-vault-cic6.onrender.com

# Database Connection (MongoDB Atlas)
# Replace <username>, <password>, and cluster details with your Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ncuxgch.mongodb.net/personal-vault?retryWrites=true&w=majority&appName=Cluster0

# Authentication & Security Secrets (Required in Production)
# Minimum 32-64 character random strings
CSRF_SECRET=a8f5b497c23de16d84950b7194f26ca3d8e9501cb6743128fae904b78c12e345
JWT_SECRET=f3a8b291c47de80a15962e7485f39bd2e8a1602dc7854239abf015c89d23e456
REFRESH_TOKEN_SECRET=d4b9c302e58ef91b26073f8596a40ce3f9b2713ed8965340bca126d90e34f567
VAULT_ENCRYPTION_KEY=e5c0d413f69fa02c37184a9607b51df4a0c3824fe9076451cdb237ea1f450678
AUTH_PEPPER=b7d1e524a70ab13d48295b0718c62ea5b1d4935ef0187562dec348fb2a561789
SIGNED_URL_SECRET=c8d2e461b95fa03d72814a0518b72ef3a9c4815fe0286412cdb348ea2f561790
RECAPTCHA_SECRET_KEY=replace-with-your-recaptcha-secret-key

# Token Expiration Settings
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_IN=30d

# Cookies & Proxy Configuration
REFRESH_COOKIE_SAME_SITE=strict
REFRESH_COOKIE_SECURE=true
TRUST_PROXY=1
ALLOW_LOCAL_CORS_ORIGINS=false

# File Upload & Body Limits
MAX_FILE_SIZE_MB=500
VITE_MAX_FILE_SIZE_MB=500
MAX_JSON_BODY_MB=5
UPLOAD_DIR=uploads
MULTIPART_TMP_ROOT=/tmp/vault/multipart-uploads

# Rate Limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# Security Features
REQUIRE_ES256_IN_PRODUCTION=false
REQUIRE_ENVELOPE_KEK_IN_PRODUCTION=false
ALLOW_RECAPTCHA_TEST_HOST=false

# Observability
SENTRY_ENABLED=false
VITE_SENTRY_ENABLED=false
