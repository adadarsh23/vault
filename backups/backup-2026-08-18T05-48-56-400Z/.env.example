# ============================================================================
# VAULT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env and configure the variables for your environment.
# For Render production deployment, refer to .env.production.example
# ============================================================================

# ============================================================================
# 1. SERVER & RUNTIME ENVIRONMENT
# ============================================================================
# Node runtime environment (development, production, test)
NODE_ENV=development

# Server port for Express backend
PORT=4000

# Render cloud service ID (optional in dev, auto-set on Render)
RENDER_SERVICE_ID=srv-your-render-service-id

# Disable origin protection when frontend and backend are on same origin
DISABLE_ORIGIN_PROTECTION=true

# Allow localhost/private-network browser origins in production (false recommended)
ALLOW_LOCAL_CORS_ORIGINS=false

# Trusted reverse proxy hops (1 when deployed behind Render / Cloudflare / Nginx)
TRUST_PROXY=1

# Enable periodic server keep-alive ping (true in production)
KEEP_ALIVE_ENABLED=true

# Enable Gzip / Brotli response compression (true in production)
ENABLE_COMPRESSION=true

# Enable overload protection when event loop lag spikes
ENABLE_OVERLOAD_PROTECTION=true

# Event loop lag threshold in milliseconds before shedding load
EVENT_LOOP_LAG_THRESHOLD_MS=1000

# ============================================================================
# 2. DATABASE CONFIGURATION (MONGODB ATLAS)
# ============================================================================
# Primary MongoDB Atlas SRV connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ncuxgch.mongodb.net/vault?retryWrites=true&w=majority&appName=Cluster0

# Secondary MongoDB Atlas URI for automatic cluster failover
MONGODB_URI_FALLBACK=mongodb+srv://<username>:<password>@cluster0.dxhm8nx.mongodb.net/vault?retryWrites=true&w=majority&appName=Cluster0

# Direct non-SRV connection string (used when DNS SRV lookups are blocked)
# Format: mongodb://<user>:<password>@host1:27017,host2:27017,host3:27017/vault?tls=true&replicaSet=atlas-xxx&authSource=admin&retryWrites=true&w=majority
MONGODB_URI_DIRECT=

# Database name
MONGODB_DB=vault

# Allow in-memory fallback if MongoDB connection fails (dev/testing only)
MONGODB_ALLOW_LOCAL_FALLBACK=false

# Primary DNS servers for MongoDB SRV resolution
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Secondary/retry DNS servers for MongoDB SRV resolution
MONGODB_DNS_RETRY_SERVERS=8.8.8.8,1.1.1.1

# Atlas connection keep-alive ping interval in minutes
ATLAS_KEEPALIVE_MINUTES=10

# Set to true to bypass MongoDB connection during local testing
SKIP_MONGO_CONNECT=false

# ============================================================================
# 3. AUTHENTICATION, SECURITY & CRYPTOGRAPHY
# ============================================================================
# JWT secret for signing access tokens (required - min 32 chars random string)
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# Access token expiration time (e.g., 12h, 15m, 1h)
JWT_EXPIRES_IN=12h

# Refresh token secret (required in production - min 32 chars random string)
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret-min-32-chars

# Refresh token expiration time (e.g., 30d, 7d)
REFRESH_TOKEN_EXPIRES_IN=30d

# CSRF secret for double-submit HMAC verification (required in production - min 32 chars)
CSRF_SECRET=replace-with-a-long-random-csrf-secret-min-32-chars

# Secret key for generating signed URLs for secure downloads & media (required in production - min 32 chars)
SIGNED_URL_SECRET=replace-with-a-long-random-signed-url-secret-min-32-chars

# Master server-side envelope encryption key (32-byte base64 or 64-char hex)
VAULT_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-char-hex-key

# Secret pepper for scrypt/Argon2 password hashing (stored on server, never in DB)
AUTH_PEPPER=replace-with-a-random-pepper-string-min-32-chars

# Bcrypt salt rounds for password hashing
BCRYPT_ROUNDS=12

# Enforce ES256 asymmetric key ring in production (false unless keys configured)
REQUIRE_ES256_IN_PRODUCTION=false

# Enforce KMS/envelope KEK in production (false unless KMS configured)
REQUIRE_ENVELOPE_KEK_IN_PRODUCTION=false

# Google reCAPTCHA v2 secret key (backend only - never expose to frontend)
RECAPTCHA_SECRET_KEY=replace-with-your-recaptcha-secret-key

# Google reCAPTCHA v2 site key (frontend public key)
VITE_RECAPTCHA_SITE_KEY=replace-with-your-recaptcha-site-key

# Allow Google test-key host validation in production (false recommended)
ALLOW_RECAPTCHA_TEST_HOST=false

# Precomputed dummy password hash to prevent timing attacks during login
DUMMY_PASSWORD_HASH=replace-with-precomputed-dummy-bcrypt-hash

# ============================================================================
# 4. CLIENT & PUBLIC URLS
# ============================================================================
# Client application URL (trusted origin for CORS & cookies)
CLIENT_URL=https://<render_url>.onrender.com

# Public canonical URL for the application
PUBLIC_URL=https://<render_url>.onrender.com/

# Vite client application public URL
VITE_APP_PUBLIC_URL=https://<render_url>.onrender.com

# Vite API base URL for client HTTP requests
VITE_API_BASE_URL=https://<render_url>.onrender.com

# Vite local development API endpoint
VITE_DEV_API_BASE_URL=http://localhost:4000

# Default API base URL fallback
VITE_DEFAULT_API_BASE_URL=http://127.0.0.1:4000

# DNS prefetch host for HTML head hints
VITE_DNS_PREFETCH_HOST=//<render_url>.onrender.com

# CSP connect-src header origins for Content Security Policy
VITE_CSP_CONNECT_SRC=https://<render_url>.onrender.com https://*.onrender.com

# Frontend application release version tag
VITE_APP_RELEASE=1.0.0

# ============================================================================
# 5. COOKIES & DEVICE SESSIONS
# ============================================================================
# Refresh token cookie domain (leave blank for host-only cookie, or set domain)
REFRESH_COOKIE_DOMAIN=<render_url>.onrender.com

# Refresh cookie SameSite policy (strict, lax, none)
REFRESH_COOKIE_SAME_SITE=strict

# Refresh cookie secure flag (true for HTTPS in production)
REFRESH_COOKIE_SECURE=true

# Session retention window in milliseconds (default: 7 days = 604800000 ms)
SESSION_RETENTION_MS=604800000

# Maximum simultaneous active devices per user
MAX_ACTIVE_DEVICES=25

# Maximum retries for optimistic concurrency conflicts on user record updates
MAX_USER_WRITE_RETRIES=3

# ============================================================================
# 6. FILE STORAGE & UPLOAD LIMITS
# ============================================================================
# Directory for persistent file vault storage
UPLOAD_DIR=uploads

# Ephemeral scratch volume for chunked multipart uploads
MULTIPART_TMP_ROOT=/tmp/vault/multipart-uploads

# Maximum file upload size in MB (server-side limit)
MAX_FILE_SIZE_MB=500

# Frontend upload size display and validation limit in MB
VITE_MAX_FILE_SIZE_MB=500

# Maximum JSON request body size in MB
MAX_JSON_BODY_MB=100

# ============================================================================
# 7. RATE LIMITING & ABUSE PREVENTION
# ============================================================================
# General API rate limit window in milliseconds (default: 15 minutes)
API_RATE_LIMIT_WINDOW_MS=900000

# General API maximum requests allowed per rate limit window
API_RATE_LIMIT_MAX=1000

# Authentication endpoint rate limit window in milliseconds (default: 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Authentication maximum requests allowed per rate limit window
AUTH_RATE_LIMIT_MAX=100

# ============================================================================
# 8. VAULT STORAGE RECORD LIMITS
# ============================================================================
# Maximum activity audit log entries retained per user
MAX_ACTIVITY_LOGS=500

# Maximum login history entries retained per user
MAX_LOGIN_HISTORY=20

# Maximum length for vault item ID strings
MAX_ITEM_ID_LENGTH=128

# Maximum character length for vault item titles
MAX_TITLE_LENGTH=200

# Maximum character length for rich text note content
MAX_NOTE_CONTENT_LENGTH=100000

# Maximum character length for standard encrypted text fields
MAX_TEXT_FIELD_LENGTH=2000

# Maximum character length for uploaded filenames
MAX_FILE_NAME_LENGTH=255

# ============================================================================
# 9. REGISTRATION PROFILE & GEOLOCATION PROVIDERS
# ============================================================================
# Enable geolocation telemetry capture during user registration
REGISTRATION_PROFILE_CAPTURE_ENABLED=true

# Geolocation API request timeout in milliseconds
REGISTRATION_PROFILE_TIMEOUT_MS=2500

# --- FreeIPAPI (free.freeipapi.com) ---
FREE_IP_API_URL_TEMPLATE=https://free.freeipapi.com/api/json/{ip}
FREE_IP_API_URL_FALLBACK=https://free.freeipapi.com/api/json

# --- IPAPI.co (ipapi.co) ---
ENABLE_IPAPI_CO=true
IPAPI_CO_URL_TEMPLATE=https://ipapi.co/{ip}/json/
IPAPI_CO_URL_FALLBACK=https://ipapi.co/json/

# --- IPWho.is (ipwho.is) ---
ENABLE_IPWHO_IS=false
IPWHOIS_URL_TEMPLATE=https://ipwho.is/{ip}
IPWHOIS_URL_FALLBACK=https://ipwho.is/

# --- IPWhois.app (ipwhois.app) ---
IPWHOIS_APP_API_KEY=replace-with-your-ipwhois-app-api-key
IPWHOIS_APP_URL_TEMPLATE=https://ipwhois.app/json/{ip}?key={apiKey}
IPWHOIS_APP_URL_FALLBACK=https://ipwhois.app/json/?key={apiKey}

# --- IPInfo.io (ipinfo.io) ---
IPINFO_IO_URL_TEMPLATE=https://ipinfo.io/{ip}/json
IPINFO_IO_URL_FALLBACK=https://ipinfo.io/json

# --- IPGeolocation.io (api.ipgeolocation.io) ---
IPGEOLOCATION_API_KEY=replace-with-your-ipgeolocation-io-api-key
IPGEOLOCATION_URL_TEMPLATE=https://api.ipgeolocation.io/ipgeo?apiKey={apiKey}&ip={ip}
IPGEOLOCATION_URL_FALLBACK=https://api.ipgeolocation.io/ipgeo?apiKey={apiKey}

# --- IPLocate.io (iplocate.io) ---
IPLOCATE_IO_API_KEY=replace-with-your-iplocate-io-api-key
IPLOCATE_IO_URL_TEMPLATE=https://iplocate.io/api/lookup/{ip}?apikey={apiKey}
IPLOCATE_IO_URL_FALLBACK=https://iplocate.io/api/lookup?apikey={apiKey}

# --- IP-API.com (ip-api.com) ---
IP_API_COM_URL_TEMPLATE=http://ip-api.com/json/{ip}
IP_API_COM_URL_FALLBACK=http://ip-api.com/json/

# ============================================================================
# 10. OBSERVABILITY, MONITORING & ANALYTICS
# ============================================================================
# Sentry error tracking master flags
SENTRY_ENABLED=false
VITE_SENTRY_ENABLED=false

# Sentry Backend Configuration
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Sentry Frontend Configuration
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=1.0.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_ENABLED=false
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.0
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=0.1
VITE_SENTRY_ENABLE_LOCALHOST=false
VITE_SENTRY_SOURCEMAPS=true

# LogRocket Session Replay & Telemetry
LOGROCKET_APP_ID=your_logrocket_backend_app_id
VITE_LOGROCKET_ENABLED=false
VITE_LOGROCKET_APP_ID=your_logrocket_frontend_app_id

# Google Analytics 4 Measurement ID
VITE_GA_ID=G-XXXXXXXXXX

# Vite bundle analysis toggle
ANALYZE_BUNDLE=false
