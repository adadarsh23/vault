# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ncuxgch.mongodb.net/personal-vault?retryWrites=true&w=majority&appName=Cluster0
# Aliases: MONGODB_URL

# Optional backup Atlas URI for automatic failover
MONGODB_URI_FALLBACK=
# Direct Atlas fallback for environments where mongodb+srv DNS is blocked.
# Format: mongodb://<user>:<password>@<host0>:27017,<host1>:27017,<host2>:27017/vault?tls=true&replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority
MONGODB_URI_DIRECT=
MONGODB_ALLOW_LOCAL_FALLBACK=false
# Aliases: MONGODB_URL_FALLBACK

# Alternative MongoDB URIs for additional failover support (URI_1, URI_2, URI_3)
# MONGODB_URI_1=mongodb+srv://...
# MONGODB_URI_2=mongodb+srv://...
# MONGODB_URI_3=mongodb+srv://...

# Comma-separated DNS servers for MongoDB resolution
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# ============================================================================
# AUTHENTICATION & ENCRYPTION
# ============================================================================
# JWT secret for token signing (required - use a long random string)
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
# CSRF secret for HMAC token verification (required in production - min 32 chars)
CSRF_SECRET=replace-with-a-long-random-csrf-secret-min-32-chars
# Secret key for generating signed URLs for secure downloads & avatars (required in production - min 32 chars)
SIGNED_URL_SECRET=replace-with-a-long-random-signed-url-secret-min-32-chars
# Enforce ES256 key ring in production (set true only after configuring JWT_*_KEY vars)
REQUIRE_ES256_IN_PRODUCTION=false

# JWT token expiration time
JWT_EXPIRES_IN=12h

# Refresh token secret (recommended to be different from JWT_SECRET)
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

# Refresh token expiration time
REFRESH_TOKEN_EXPIRES_IN=30d

# Vault encryption key (32-byte base64 or 64-char hex string - required)
VAULT_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-char-hex-key

# Pepper for scrypt hashing (Secret value stored in server, not DB)
AUTH_PEPPER=replace-with-a-random-pepper-string
# Google reCAPTCHA secret key (backend only - never expose to frontend)
RECAPTCHA_SECRET_KEY=replace-with-your-recaptcha-secret-key
# Allow Google test-key host validation in production only if intentionally enabled.
ALLOW_RECAPTCHA_TEST_HOST=false
# Enforce envelope KEK in production (set true only after configuring ENVELOPE_KEK/KMS_ENVELOPE_KEK)
REQUIRE_ENVELOPE_KEK_IN_PRODUCTION=false

# ============================================================================
# CLIENT & PUBLIC URLs
# ============================================================================
# Client application URL
CLIENT_URL=https://my-vault-cic6.onrender.com

# Public URL for the application
PUBLIC_URL=https://my-vault-cic6.onrender.com

# Vite public URL
VITE_APP_PUBLIC_URL=https://my-vault-cic6.onrender.com/

# Google Analytics 4 Measurement ID (frontend)
VITE_GA_ID=
VITE_LOGROCKET_APP_ID=your_app_id
# Google reCAPTCHA v2 site key (frontend public key)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# DNS prefetch host for performance
VITE_DNS_PREFETCH_HOST=//my-vault-cic6.onrender.com

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Render service ID (for Render deployments)
RENDER_SERVICE_ID=srv-your-render-service-id
# Aliases: SERVICE_ID

# API base URL for client
VITE_API_BASE_URL=https://my-vault-cic6.onrender.com

# Development API base URL
VITE_DEV_API_BASE_URL=http://localhost:4000

# Default API base URL fallback
VITE_DEFAULT_API_BASE_URL=http://127.0.0.1:4000

# CSP Connect-Src header for security policy
VITE_CSP_CONNECT_SRC=https://my-vault-cic6.onrender.com https://*.onrender.com

# Bundle analysis flag
ANALYZE_BUNDLE=false

# Upload directory for file vault storage
UPLOAD_DIR=uploads

# Multipart upload temporary workspace. Set this to a writable ephemeral
# volume in cloud deployments (example: /tmp/vault/multipart-uploads).
MULTIPART_TMP_ROOT=/tmp/vault/multipart-uploads

# ============================================================================
# FILE UPLOAD LIMITS
# ============================================================================
# Maximum file size in MB
MAX_FILE_SIZE_MB=500

# Frontend upload size display/validation in MB
VITE_MAX_FILE_SIZE_MB=500

# Maximum JSON request body size in MB
MAX_JSON_BODY_MB=5

# ============================================================================
# RATE LIMITING
# ============================================================================
# General API rate limit window (milliseconds)
API_RATE_LIMIT_WINDOW_MS=900000

# General API rate limit max requests per window
API_RATE_LIMIT_MAX=1000

# Authentication rate limit window (milliseconds)
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Authentication rate limit max requests per window
AUTH_RATE_LIMIT_MAX=100

# ============================================================================
# SECURITY & COOKIES
# ============================================================================
# Refresh token cookie same-site policy (strict, lax, none)
REFRESH_COOKIE_SAME_SITE=strict

# Refresh token cookie secure flag (true for HTTPS only)
REFRESH_COOKIE_SECURE=true

# Refresh token cookie domain (leave empty for current domain)
REFRESH_COOKIE_DOMAIN=

# Trusted proxy hops (use number of proxies in front of app, or leave as 1)
TRUST_PROXY=1
# Allow localhost/private-network browser origins in production (not recommended).
ALLOW_LOCAL_CORS_ORIGINS=false

# ============================================================================
# VAULT CONFIGURATION
# ============================================================================
# Maximum activity logs to keep per user
MAX_ACTIVITY_LOGS=500

# Maximum login history entries to keep per user
MAX_LOGIN_HISTORY=20

# Maximum active devices per user
MAX_ACTIVE_DEVICES=25

# Maximum item ID length
MAX_ITEM_ID_LENGTH=128

# Maximum title field length
MAX_TITLE_LENGTH=200

# Maximum note content length
MAX_NOTE_CONTENT_LENGTH=100000

# Maximum general text field length
MAX_TEXT_FIELD_LENGTH=1000

# Maximum file name length
MAX_FILE_NAME_LENGTH=255

# Session retention time in milliseconds (default: 7 days)
SESSION_RETENTION_MS=604800000

# Maximum retries for user mutations on optimistic concurrency conflicts
MAX_USER_WRITE_RETRIES=3

# ============================================================================
# REGISTRATION PROFILE & GEOLOCATION
# ============================================================================
# Enable registration profile capture (geolocation data at signup)
REGISTRATION_PROFILE_CAPTURE_ENABLED=true

# Timeout for geolocation API requests (milliseconds)
REGISTRATION_PROFILE_TIMEOUT_MS=2500

# --- FREE_IP_API (free.freeipapi.com) ---
# Free geolocation API, no registration required
# URL template with {ip} placeholder
FREE_IP_API_URL_TEMPLATE=https://free.freeipapi.com/api/json/{ip}

# Fallback URL (used when IP is unavailable)
FREE_IP_API_URL_FALLBACK=https://free.freeipapi.com/api/json

# --- IP-WHO.IS (ipwho.is) ---
# Enable ipwho.is provider
ENABLE_IPWHO_IS=false

# URL template with {ip} placeholder
IPWHOIS_URL_TEMPLATE=https://ipwho.is/{ip}

# Fallback URL
IPWHOIS_URL_FALLBACK=https://ipwho.is/

# --- IPWHOIS.APP (ipwhois.app) ---
# API key for ipwhois.app (get from https://ipwhois.app/)
IPWHOIS_APP_API_KEY=replace-with-your-ipwhois-app-api-key

# URL template with {ip} and {apiKey} placeholders
IPWHOIS_APP_URL_TEMPLATE=https://ipwhois.app/json/{ip}?key={apiKey}

# Fallback URL with {apiKey} placeholder
IPWHOIS_APP_URL_FALLBACK=https://ipwhois.app/json/?key={apiKey}

# --- IP-API.COM (ip-api.com) ---
# Free geolocation API (limited free tier - 45 requests/minute)
# URL template with {ip} placeholder
IP_API_COM_URL_TEMPLATE=http://ip-api.com/json/{ip}

# Fallback URL
IP_API_COM_URL_FALLBACK=http://ip-api.com/json/

# --- IPGEOLOCATION.IO (api.ipgeolocation.io) ---
# API key for ipgeolocation.io (get from https://ipgeolocation.io/)
IPGEOLOCATION_API_KEY=replace-with-your-ipgeolocation-io-api-key

# URL template with {apiKey} and {ip} placeholders
IPGEOLOCATION_URL_TEMPLATE=https://api.ipgeolocation.io/ipgeo?apiKey={apiKey}&ip={ip}

# Fallback URL with {apiKey} placeholder
IPGEOLOCATION_URL_FALLBACK=https://api.ipgeolocation.io/ipgeo?apiKey={apiKey}

# --- IPLOCATE.IO (iplocate.io) ---
# API key for iplocate.io (get from https://iplocate.io/)
IPLOCATE_IO_API_KEY=replace-with-your-iplocate-io-api-key

# URL template with {apiKey} and {ip} placeholders
IPLOCATE_IO_URL_TEMPLATE=https://iplocate.io/api/lookup/{ip}?apikey={apiKey}

# Fallback URL with {apiKey} placeholder
IPLOCATE_IO_URL_FALLBACK=https://iplocate.io/api/lookup?apikey={apiKey}

# --- IPAPI.CO (ipapi.co) ---
# Free geolocation API, no API key required, generous free tier
# Enable ipapi.co provider
ENABLE_IPAPI_CO=true

# URL template with {ip} placeholder
IPAPI_CO_URL_TEMPLATE=https://ipapi.co/{ip}/json/

# Fallback URL
IPAPI_CO_URL_FALLBACK=https://ipapi.co/json/

VITE_GA_ID=G-XXXXXXXXXX

# ============================================================================
# PASSWORDS & SECRETS (FOR SECURITY TESTING)
# ============================================================================
# DUMMY_PASSWORD_HASH=$2b$12$kBdayC1Q/sgRqxBzBn1u6OxfBuHHqqSQ/roJTvkTua.U9/o3pDP6K

# ============================================================================
# SENTRY OBSERVABILITY (FRONTEND + BACKEND)
# ============================================================================
# Master enable flag (if false, Sentry still auto-enables in production when DSN exists)
SENTRY_ENABLED=false
VITE_SENTRY_ENABLED=false

# Backend
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
LOGROCKET_APP_ID=your_app_id

# Frontend
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=1.0.0
VITE_APP_RELEASE=1.0.0
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_ENABLED=false
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.0
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=0.1
VITE_SENTRY_ENABLE_LOCALHOST=false
VITE_SENTRY_SOURCEMAPS=true
