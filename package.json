    "clean:build": "node scripts/clean.mjs --build",
    "clean:stats": "node scripts/clean.mjs --stats",
    "clean:vite": "node scripts/clean.mjs --vite",
    "clean:coverage": "node scripts/clean.mjs --coverage",
    "clean:reports": "node scripts/clean.mjs --reports",
    "clean:memory": "node scripts/clean.mjs --memory",
    "clean:npm": "npm cache clean --force",
    "clean:all": "node scripts/clean.mjs --all",
    "backup": "node -e \"const fs=require('fs'); const path=require('path'); const root=process.cwd(); const stamp=new Date().toISOString().replace(/[.:]/g,'-'); const backupRoot=path.join(root,'backups'); const target=path.join(backupRoot,`backup-${stamp}`); const skip=new Set(['node_modules','build','.git','backups']); fs.mkdirSync(target,{recursive:true}); for (const entry of fs.readdirSync(root,{withFileTypes:true})) { if (skip.has(entry.name)) continue; fs.cpSync(path.join(root,entry.name), path.join(target,entry.name), {recursive:true}); } const manifest={ createdAt:new Date().toISOString(), source:root, target, skipped:[...skip] }; fs.writeFileSync(path.join(target,'backup-manifest.json'), JSON.stringify(manifest,null,2)); console.log('Backup created at:', target);\"",
    "verify": "npm run lint && npm run test",
    "verify:quick": "npm run lint && npm run test:auth",
    "verify:ci": "npm run doctor && npm run lint && npm run test:ci && npm run build",
    "verify:full": "npm run clean:all && npm run doctor && npm run verify && npm run test:all",
    "update:check": "npm outdated",
    "update:safe": "npm update",
    "update:all": "npx npm-check-updates -u && npm install",
    "check:audit": "npm audit",
    "fix:audit": "npm audit fix",
    "zip:prod": "node scripts/zip-prod.mjs"
  },
