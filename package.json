{
  "name": "vault",
  "description": "Secure full-stack personal vault with encrypted storage, device sessions, and cloud sync. ",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "vault",
    "security",
    "encryption",
    "react",
    "vite",
    "express",
    "mongodb"
  ],
  "license": "UNLICENSED",
  "sideEffects": false,
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:client": "vite",
    "dev:host": "vite --host",
    "start": "tsx server.ts",
    "start:e2e": "set \"NODE_ENV=production\" && set \"SKIP_MONGO_CONNECT=1\" && npm run build && npm run start",
    "push:gitbash": "node scripts/run-push-gitbash.cjs",
    "keepalive": "node scripts/atlas-keepalive.mjs",
    "build": "vite build",
    "build:minify": "set \"VITE_BUILD_MINIFY=oxc\" && set \"VITE_BUILD_SOURCEMAP=false\" && vite build --mode production",
    "build:minify:terser": "set \"VITE_BUILD_MINIFY=terser\" && set \"VITE_BUILD_SOURCEMAP=false\" && vite build --mode production",
    "build:compress": "npm run build:minify",
    "build:compress:terser": "npm run build:minify:terser",
    "build:analyze": "set \"ANALYZE_BUNDLE=true\" && vite build",
    "build:perf": "vite build --mode production --debug",
    "lighthouse": "node scripts/lighthouse-runner.mjs && start \"\" \".\\lighthouse\\report-split\\index.html\" && echo \"Lighthouse split report generated at .\\lighthouse\\report-split\\index.html\"",
    "stats": "start .\\stats.html",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "backup": "node -e \"const fs=require('fs'); const path=require('path'); const root=process.cwd(); const stamp=new Date().toISOString().replace(/[.:]/g,'-'); const backupRoot=path.join(root,'backups'); const target=path.join(backupRoot,`backup-${stamp}`); const skip=new Set(['node_modules','build','.git','backups']); fs.mkdirSync(target,{recursive:true}); for (const entry of fs.readdirSync(root,{withFileTypes:true})) { if (skip.has(entry.name)) continue; fs.cpSync(path.join(root,entry.name), path.join(target,entry.name), {recursive:true}); } const manifest={ createdAt:new Date().toISOString(), source:root, target, skipped:[...skip] }; fs.writeFileSync(path.join(target,'backup-manifest.json'), JSON.stringify(manifest,null,2)); console.log('Backup created at:', target);\"",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "clean:stats": "node -e \"require('fs').rmSync('stats.html',{force:true})\"",
    "clean:vite": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "type-check": "npm run typecheck",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "lint": "npm run typecheck && npm run typecheck:server",
    "lint:strict": "npm run lint && npm run test:unit",
    "test": "vitest run --maxWorkers 1",
    "test:all": "npm run format:check && npm run lint:strict && npm run test && npm run test:crypto && npm run test:auth && npm run test:unit && npm run test:changed && npm run security:rewrap-kek && npm run test:security:integration && npm run test:video-player && npm run test:todo-vault:security",
    "test:audit": "npm run lint && npm run test:security && npm run check:audit",
    "test:auth": "vitest run tests/integration/auth.integration.test.ts",
    "test:avatar": "vitest run tests/unit/avatar-pipeline.test.ts",
    "test:changed": "node scripts/vitest-related.mjs run",
    "test:ci": "vitest run --no-cache --typecheck",
    "test:components": "vitest run test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:coverage:deep": "vitest run --coverage --logHeapUsage",
    "test:crypto": "vitest run tests/unit/encryption.test.ts",
    "test:deep": "vitest run --reporter=verbose --bail=1",
    "test:deep:all": "npm run typecheck && npm run typecheck:server && npm run test:unit && npm run test:integration && npm run test:components && npm run test:security",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/auth-session.spec.ts",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:debug": "playwright test --project=chromium --reporter=list",
    "test:e2e:deep": "playwright test --fully-parallel --retries=2 --reporter=html,list",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:privacy": "playwright test tests/e2e/privacy_interface_deep_audit.spec.ts",
    "test:e2e:report": "playwright test --reporter=html",
    "test:e2e:report:open": "playwright show-report",
    "test:e2e:specs": "playwright test tests/e2e/specs",
    "test:e2e:trace": "playwright test --trace=on",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:ui && npm run test:e2e:headed && npm run test:e2e:debug && npm run test:e2e:report",
    "test:flaky": "vitest run --retry=5",
    "test:heap": "vitest run --logHeapUsage",
    "test:integration": "vitest run tests/integration",
    "test:matrix": "npm run test:deep:all && npm run test:e2e:all",
    "test:multipart": "vitest run tests/integration/multipart-security.test.ts",
    "test:related": "node scripts/vitest-related.mjs watch",
    "test:runner": "tsx tests/run-tests.ts",
    "test:security": "vitest run tests/integration/auth-security.test.ts tests/integration/multipart-security.test.ts tests/integration/streaming-security.test.ts src/security/securityIntegration.test.tsx src/features/vault/TodoVault.security.test.tsx",
    "test:security:all": "npm run test:security",
    "test:security:integration": "vitest run src/security/securityIntegration.test.tsx",
    "test:server-crypto": "vitest run tests/unit/server-crypto.test.ts",
    "test:settings": "vitest run src/features/vault/__tests__/SettingsVault",
    "test:settings:all": "vitest run src/features/vault/__tests__/SettingsVault",
    "test:settings:integration": "vitest run src/features/vault/__tests__/SettingsVault/SettingsVaultIntegration.test.tsx",
    "test:streaming": "vitest run tests/integration/streaming-security.test.ts",
    "test:streaming:media": "vitest run src/lib/__tests__/encryptedMediaStreaming.test.ts",
    "test:sync": "vitest run tests/unit/sync-",
    "test:todo-vault:security": "vitest run src/features/vault/TodoVault.security.test.tsx",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest --watch",
    "test:vault": "vitest run tests/unit/vault-",
    "test:video-player": "vitest run src/components/ui/video-player.test.tsx",
    "test:watch": "vitest",
    "update:check": "npm outdated",
    "update:safe": "npm update",
    "update:all": "npx npm-check-updates -u && npm install",
    "check:audit": "npm audit",
    "fix:audit": "npm audit fix",
    "clean:npm": "npm cache clean --force",
    "verify": "npm run lint && npm run test && npm run build",
    "verify:quick": "npm run lint && npm run test:auth",
    "verify:full": "npm run clean && npm run clean:stats && npm run verify",
    "memory:index": "node scripts/code-memory-index.mjs",
    "memory:visual": "node scripts/code-memory-visual.mjs",
    "memory:all": "npm run memory:index && npm run memory:visual && start \"\" \".\\.memory\\index.html\" && echo \"Memory indexing and visualization complete!\"",
    "security:rewrap-kek": "tsx server/scripts/rewrapEnvelopeKeys.ts --dry-run",
    "zip:prod": "node scripts/zip-prod.mjs",
    "build:zip:analyze": "npm run build:analyze && npm run memory:all && npm run backup && npm run zip:prod && npm run stats && npm run lighthouse && npm run format && npm run format:check && echo \"Building and analyzing complete!\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tsparticles/engine": "^4.3.2",
    "@tsparticles/react": "^4.3.2",
    "@tsparticles/slim": "^4.3.2",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "hash-wasm": "^4.12.0",
    "heic2any": "^0.0.4",
    "helmet": "^8.3.0",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "ip-range-check": "^0.2.0",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.8.4",
    "logrocket": "^12.1.1",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.7",
    "mongodb": "^7.5.0",
    "morgan": "^1.11.0",
    "motion": "^12.43.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "otpauth": "^9.5.1",
    "pqc-kyber": "^0.7.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.11.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.1",
    "shaka-player": "^5.2.4",
    "socket.io": "^4.8.3",
    "sonner": "^2.0.7",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "mongoose": "^9.9.1",
    "playwright": "^1.62.1",
    "prettier": "^3.5.3",
    "rollup": "^4.62.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@sentry/node-cpu-profiler@2.4.2": true,
    "@tsparticles/engine@4.3.2": true,
    "esbuild@0.28.1": true
  }
}
