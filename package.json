{
  "name": "vault",
  "description": "Secure encrypted vault for storing photos, videos, notes, documents, and passwords with client-side encryption.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "author": {
    "name": "Adarsh",
    "role": "Developer",
    "url": "https://github.com/adadarsh23"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adadarsh23/vault"
  },
  "homepage": "https://github.com/adadarsh23/vault#readme",
  "engines": {
    "node": ">=18.20.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "vault",
    "encryption",
    "password-manager",
    "secure-storage",
    "privacy",
    "zero-knowledge",
    "client-side-encryption"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch server.ts",
    "verify:jwt": "tsx scripts/verify-jwt.ts",
    "dev:client": "vite",
    "dev:host": "vite --host",
    "dev:debug": "tsx watch --inspect server.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "build:all": "npm run build && npm run build:server",
    "build:prod": "node scripts/build-env.mjs --minify=oxc --sourcemap=false --mode=production",
    "build:minify:terser": "node scripts/build-env.mjs --minify=terser --sourcemap=false --mode=production",
    "build:analyze": "node scripts/build-env.mjs --analyze",
    "build:perf": "node scripts/build-env.mjs --mode=production --debug",
    "build:zip": "npm run build && npm run zip:prod",
    "build:zip:analyze": "npm run lint:strict && npm run format && npm run format:check && npm run build:analyze && npm run memory:all && npm run backup && npm run backup:info && npm run zip:prod && npm run lighthouse:ci && npm run stats:chrome",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:server",
    "lint": "npm run typecheck:all",
    "lint:strict": "npm run lint && npm run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers 1",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --open",
    "test:ui:coverage": "vitest --ui --coverage --open",
    "test:fast": "vitest run --bail=1",
    "test:verbose": "vitest run --reporter=verbose",
    "test:silent": "vitest run --silent",
    "test:ci": "npm run lint && vitest run --no-cache",
    "test:flaky": "vitest run --retry=5",
    "test:heap": "vitest run --logHeapUsage",
    "test:debug": "vitest run --inspect --no-file-parallelism",
    "test:debug:watch": "vitest --inspect --no-file-parallelism",
    "test:debug:brk": "vitest run --inspect-brk --no-file-parallelism",
    "test:update": "vitest run -u",
    "test:changed": "node scripts/vitest-related.mjs run",
    "test:related": "node scripts/vitest-related.mjs watch",
    "test:coverage": "vitest run --coverage",
    "test:coverage:deep": "vitest run --coverage --logHeapUsage",
    "test:coverage:open": "vitest run --coverage && node scripts/open-report.mjs coverage/index.html",
    "test:runner": "tsx tests/run-tests.ts",
    "test:all": "npm run lint && npm run test:run && npm run test:runner",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest --watch tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:watch": "vitest --watch tests/integration",
    "test:components": "vitest run .test.tsx",
    "test:components:watch": "vitest --watch .test.tsx",
    "test:client": "vitest run src",
    "test:server": "vitest run tests/unit/server- tests/unit/auth- tests/unit/sentry- tests/unit/logrocket- tests/integration",
    "test:e2e": "vitest run tests/integration",
    "test:auth": "vitest run tests/integration/auth.integration.test.ts tests/unit/auth-",
    "test:auth:unit": "vitest run tests/unit/auth-",
    "test:auth:integration": "vitest run tests/integration/auth.integration.test.ts",
    "test:auth:security": "vitest run tests/integration/auth-security.test.ts",
    "test:security": "vitest run tests/integration/auth-security.test.ts tests/integration/multipart-security.test.ts tests/integration/streaming-security.test.ts src/security/securityIntegration.test.tsx src/features/vault/TodoVault.security.test.tsx",
    "test:security:integration": "vitest run src/security/securityIntegration.test.tsx",
    "test:crypto": "vitest run tests/unit/encryption.test.ts tests/unit/server-crypto.test.ts tests/unit/account-session-profile-encryption.test.ts src/lib/__tests__/encryptedMediaStreaming.test.ts",
    "test:crypto:unit": "vitest run tests/unit/encryption.test.ts",
    "test:crypto:server": "vitest run tests/unit/server-crypto.test.ts",
    "test:crypto:rotation": "vitest run tests/unit/vault-key-rotation.test.ts tests/unit/vault-key-check.test.ts",
    "test:vault": "vitest run tests/unit/vault-",
    "test:vault:core": "vitest run tests/unit/vault-item-content.test.ts tests/unit/vault-drag-drop.test.ts tests/unit/legacy-vault-parser.test.ts",
    "test:vault:chat": "vitest run tests/unit/chat-vault-",
    "test:vault:todo": "vitest run src/features/vault/TodoVault.security.test.tsx",
    "test:sync": "vitest run tests/unit/sync-",
    "test:sync:corruption": "vitest run tests/unit/sync-download-corruption.test.ts",
    "test:sync:stores": "vitest run tests/unit/activity-store.test.ts tests/unit/privacy-interface-store.test.ts tests/unit/total-user-mirror.test.ts",
    "test:settings": "vitest run src/features/vault/__tests__/SettingsVault",
    "test:settings:integration": "vitest run src/features/vault/__tests__/SettingsVault/SettingsVaultIntegration.test.tsx",
    "test:shortcuts": "vitest run src/features/vault/__tests__/ControlsAndShortcuts.test.tsx src/features/vault/__tests__/ShortcutsCard.test.tsx",
    "test:password": "vitest run tests/unit/password- tests/unit/pinning.test.ts",
    "test:media": "vitest run src/components/ui/video-player.test.tsx src/lib/__tests__/encryptedMediaStreaming.test.ts tests/integration/streaming-security.test.ts src/features/vault/components/MediaVault",
    "test:video": "vitest run src/components/ui/video-player.test.tsx",
    "test:capture": "vitest run src/features/vault/components/LiveCaptureModal",
    "test:streaming": "vitest run tests/integration/streaming-security.test.ts",
    "test:streaming:media": "vitest run src/lib/__tests__/encryptedMediaStreaming.test.ts",
    "test:avatar": "vitest run tests/unit/avatar-pipeline.test.ts tests/unit/mongo-atlas-avatar.test.ts",
    "test:multipart": "vitest run tests/integration/multipart-security.test.ts tests/unit/upload-validation.test.ts tests/unit/signed-url.test.ts",
    "test:monitoring": "vitest run tests/unit/sentry-backend.test.ts tests/unit/logrocket-backend.test.ts tests/unit/logrocket-frontend.test.ts",
    "test:sentry": "vitest run tests/unit/sentry-backend.test.ts",
    "test:logrocket": "vitest run tests/unit/logrocket-",
    "test:utils": "vitest run tests/unit/env.test.ts tests/unit/fuzzy.test.ts tests/unit/apiClient.test.ts",
    "test:env": "vitest run tests/unit/env.test.ts",
    "test:backup": "vitest run tests/unit/backup.test.ts",
    "test:lighthouse": "vitest run tests/unit/lighthouse-runner.test.ts",
    "test:reports": "vitest run tests/unit/open-report.test.ts",
    "doctor": "node scripts/doctor.mjs",
    "env:check": "node scripts/env-check.mjs",
    "db:ping": "node scripts/db-ping.mjs",
    "keepalive": "node scripts/atlas-keepalive.mjs",
    "keepalive:once": "node scripts/atlas-keepalive.mjs --once",
    "security:rewrap-kek": "tsx server/scripts/rewrapEnvelopeKeys.ts --dry-run",
    "lighthouse": "node scripts/lighthouse-runner.mjs",
    "lighthouse:desktop": "node scripts/lighthouse-runner.mjs --desktop",
    "lighthouse:ci": "node scripts/lighthouse-runner.mjs --assert --min-score-accessibility=90 --min-score-best-practices=90 --min-score-seo=90 --min-score-performance=65",
    "lighthouse:split": "node scripts/lighthouse-runner.mjs --split-existing-report",
    "lighthouse:open": "node scripts/open-report.mjs lighthouse/report-split/index.html",
    "lighthouse:chrome": "node scripts/open-report.mjs lighthouse/report-split/index.html --chrome",
    "stats": "node scripts/open-report.mjs stats.html",
    "stats:chrome": "node scripts/open-report.mjs stats.html --chrome",
    "memory:index": "node scripts/code-memory-index.mjs",
    "memory:visual": "node scripts/code-memory-visual.mjs",
    "memory:open": "node scripts/open-report.mjs .memory/index.html",
    "memory:all": "npm run memory:index && npm run memory:visual && npm run memory:open",
    "clean": "node scripts/clean.mjs --build",
    "clean:stats": "node scripts/clean.mjs --stats",
    "clean:vite": "node scripts/clean.mjs --vite",
    "clean:coverage": "node scripts/clean.mjs --coverage",
    "clean:reports": "node scripts/clean.mjs --reports",
    "clean:memory": "node scripts/clean.mjs --memory",
    "clean:npm": "npm cache clean --force",
    "clean:all": "node scripts/clean.mjs --all",
    "backup": "node scripts/backup.mjs",
    "backup:info": "node scripts/backup.mjs --info",
    "verify": "npm run lint && npm run test",
    "verify:quick": "npm run lint && npm run test:auth",
    "verify:ci": "npm run doctor && npm run lint && npm run test:ci && npm run build",
    "verify:full": "npm run clean:all && npm run doctor && npm run verify && npm run test:all",
    "update:check": "npm outdated",
    "update:safe": "npm update",
    "update:all": "npx npm-check-updates -u && npm install",
    "check:audit": "npm audit",
    "fix:audit": "npm audit fix",
    "zip:prod": "node scripts/zip-prod.mjs"
  },
