{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Production (Remote / SSH Tunnel / K8s)",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app",
      "sourceMaps": true,
      "smartStep": true,
      "autoAttachChildProcesses": true,
      "continueOnAttach": true,
      "timeout": 30000,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "outputCapture": "std"
    },
    {
      "name": "Attach to Local Docker Container",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app",
      "restart": true,
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Attach to Process ID (Local / SSH Remote)",
      "type": "node",
      "request": "attach",
      "processId": "${command:PickProcess}",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Attach to Dev Server (tsx watch --inspect)",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    }
  ]
}
